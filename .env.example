# --- Supabase ---------------------------------------------------------
# Runtime connection: Supavisor pooler, TRANSACTION mode (port 6543).
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Direct / session-mode connection (port 5432). Only used by
# scripts/setup_checkpointer.py to create the LangGraph tables.
DIRECT_DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

SUPABASE_URL=https://<ref>.supabase.co
# Legacy projects sign JWTs with a shared secret (HS256). Leave blank on
# projects using asymmetric signing keys - the JWKS endpoint is used then.
JWT_SECRET=

# --- Models -----------------------------------------------------------
GOOGLE_API_KEY=
TRIBE_APP_MODEL=gemini-3.5-flash-lite
VOYAGE_API_KEY=

# --- ProfitConnect ----------------------------------------------------
SCHEDULE_API_KEY=
FACILITY_ID=2

# --- HTTP -------------------------------------------------------------
# Comma-separated list of allowed browser origins. No wildcard default.
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX=20
